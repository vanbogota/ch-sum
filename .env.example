# Copy to .env and fill in. NEVER commit .env.

# --- Claude (API) ---
# Needed for automatic drafts and the bot's own Claude features.
# Leave empty to use only the MCP connector with your Claude subscription.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional gateway, e.g. LiteLLM: http://litellm:4000/anthropic (pass-through) or http://litellm:4000.
# Then ANTHROPIC_API_KEY is the gateway's virtual key and ANTHROPIC_MODEL its model name.
ANTHROPIC_BASE_URL=

# --- Telegram userbot (your personal account, from https://my.telegram.org) ---
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=./secrets/ivan.session

# --- Control bot (create via @BotFather). Optional if you only use the MCP connector ---
CONTROL_BOT_TOKEN=
# your own numeric Telegram user id
OWNER_TG_ID=

# --- Contact (defaults; both can be changed in the bot with /contact and /chat) ---
# numeric user id of the default contact; `python -m ghostwriter chats` lists ids. Optional.
VLADIMIR_TG_ID=
# Optional: chat to watch if it is not the private chat with the contact
# (group id like -1001234567890 or @username). Defaults to VLADIMIR_TG_ID.
TG_CHAT=
OWNER_NAME=Ivan
CONTACT_NAME=Vladimir

# --- Email (optional: leave IMAP_HOST empty to disable) ---
VLADIMIR_EMAIL=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_INBOX_FOLDER=INBOX
# Gmail: "[Gmail]/Sent Mail"
IMAP_SENT_FOLDER=Sent
EMAIL_POLL_SECONDS=60
SMTP_HOST=
# 465 = SSL, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# defaults to SMTP_USER
EMAIL_FROM=

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/ghostwriter.db

# --- Behaviour ---
TIMEZONE=Europe/Helsinki
ACTIVE_HOURS=09:00-23:00
REPLY_DELAY_SECONDS=60-600
# wait for the contact to finish a burst of messages
DEBOUNCE_SECONDS=30
# --- Prompt size of drafts (the main token cost) ---
# messages of context before the ones being answered
HISTORY_LIMIT=15
# your recent hand-typed messages used as style reference
STYLE_SAMPLE_SIZE=15
# at most this many newest unanswered messages are answered at once
REPLY_BATCH_LIMIT=6
# long messages / forwarded posts are cut to this many characters in draft prompts
DRAFT_MESSAGE_CHARS=700
# context messages for the sensitive-topic check
ESCALATION_HISTORY=8
# telegram history imported on startup (0 = off)
BACKFILL_ON_START=200
# send non-escalated drafts without approval
AUTO_MODE=false
LOG_LEVEL=INFO

# --- MCP connector for the Claude apps (claude.ai, mobile, Desktop, Claude Code) ---
MCP_ENABLED=false
# oauth: connector URL https://<MCP_DOMAIN>/mcp, you log in with a password once per connected app
# token: connector URL https://<MCP_DOMAIN>/<MCP_TOKEN>/mcp (secret in the URL)
MCP_AUTH=oauth
# for oauth: `docker compose run --rm ghostwriter hash-password`
MCP_PASSWORD_HASH=
# for token: 24+ characters, `openssl rand -hex 24`
MCP_TOKEN=
# allow Claude to send messages as you (each send is still confirmed in the Claude app)
MCP_ALLOW_SEND=false
MCP_PORT=8765
# public HTTPS name for Caddy (docker compose --profile https up -d), e.g. 203-0-113-7.sslip.io
MCP_DOMAIN=
