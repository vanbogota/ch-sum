# Copy to .env and fill in. NEVER commit .env.

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Telegram userbot (your personal account, from https://my.telegram.org) ---
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=./secrets/ivan.session

# --- Control bot (create via @BotFather) ---
CONTROL_BOT_TOKEN=
OWNER_TG_ID=            # your own numeric Telegram user id

# --- Contact ---
VLADIMIR_TG_ID=         # numeric user id; `python -m ghostwriter chats` lists ids
# Optional: chat to watch if it is not the private chat with the contact
# (group id like -1001234567890 or @username). Defaults to VLADIMIR_TG_ID.
TG_CHAT=
OWNER_NAME=Ivan
CONTACT_NAME=Vladimir

# --- Email (optional: leave IMAP_HOST empty to disable) ---
VLADIMIR_EMAIL=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_INBOX_FOLDER=INBOX
IMAP_SENT_FOLDER=Sent           # Gmail: "[Gmail]/Sent Mail"
EMAIL_POLL_SECONDS=60
SMTP_HOST=
SMTP_PORT=465                   # 465 = SSL, 587 = STARTTLS
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=                     # defaults to SMTP_USER

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/ghostwriter.db

# --- Behaviour ---
TIMEZONE=Europe/Helsinki
ACTIVE_HOURS=09:00-23:00
REPLY_DELAY_SECONDS=60-600
DEBOUNCE_SECONDS=30             # wait for the contact to finish a burst of messages
HISTORY_LIMIT=40                # messages of context given to the drafter
STYLE_SAMPLE_SIZE=40            # your recent real messages used as style reference
BACKFILL_ON_START=200           # telegram history imported on startup (0 = off)
AUTO_MODE=false                 # send non-escalated drafts without approval
LOG_LEVEL=INFO
